FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y \
    qemu-kvm \
    qemu-system-x86 \
    qemu-img \
    openssh-clients \
    shadow-utils \
    ca-certificates \
    tar \
    gzip \
    curl \
    && microdnf clean all \
    && LIMA_VER=$(curl -s https://api.github.com/repos/lima-vm/lima/releases/latest | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/' || echo "1.0.0") \
    && curl -fsSL "https://github.com/lima-vm/lima/releases/download/v${LIMA_VER}/lima-${LIMA_VER}-Linux-x86_64.tar.gz" | tar -C /usr/local -xzf - \
    && useradd -m -u 1000 -s /bin/bash lima
ENTRYPOINT ["sleep", "infinity"]
